<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Mark_Trigger_Execution</name>
        <label>Mark Trigger Execution</label>
        <description>Marks the triggering Account on both create and update.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>$Record.Description</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>SFPI create-update trigger fired</stringValue></value>
        </assignmentItems>
    </assignments>
    <description>Before-save Account fixture that proves the CreateAndUpdate trigger configuration on both operations.</description>
    <label>SF Pi Advanced Create and Update Trigger</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Mark_Trigger_Execution</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountNumber</field>
            <operator>EqualTo</operator>
            <value><stringValue>SFPI-ADVANCED-CREATE-UPDATE</stringValue></value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>80</triggerOrder>
</Flow>
