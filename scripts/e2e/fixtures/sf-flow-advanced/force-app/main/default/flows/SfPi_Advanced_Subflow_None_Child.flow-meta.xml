<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Return_None_Text</name>
        <label>Return None Text</label>
        <description>Returns a success token only if this triggered child is actually launched as a subflow.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>outputText</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>None_Text</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Autolaunched-looking child that explicitly declares triggerType None so a subflow caller can prove the runtime contract.</description>
    <formulas>
        <name>None_Text</name>
        <dataType>String</dataType>
        <expression>{!inputText} &amp; &quot;|none&quot;</expression>
    </formulas>
    <label>SF Pi Advanced Subflow None Child</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Return_None_Text</targetReference></connector>
        <triggerType>None</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>inputText</name>
        <dataType>String</dataType>
        <description>Text supplied by the parent subflow call.</description>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outputText</name>
        <dataType>String</dataType>
        <description>Success token returned only if the None trigger child runs as a subflow.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
