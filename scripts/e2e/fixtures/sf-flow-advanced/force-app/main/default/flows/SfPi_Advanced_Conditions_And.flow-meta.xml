<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Mark_And_Match</name>
        <label>Mark AND Match</label>
        <description>Marks Opportunities that satisfy every typed entry condition.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>$Record.Description</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>SFPI entry AND matched</stringValue></value>
        </assignmentItems>
    </assignments>
    <description>Before-save Opportunity fixture covering AND entry criteria over string, currency, date, picklist, boolean, and nullable fields.</description>
    <label>SF Pi Advanced AND Conditions</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Mark_And_Match</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Name</field><operator>StartsWith</operator><value><stringValue>SFPI AND</stringValue></value></filters>
        <filters><field>Name</field><operator>EndsWith</operator><value><stringValue>End</stringValue></value></filters>
        <filters><field>Name</field><operator>Contains</operator><value><stringValue>Complex</stringValue></value></filters>
        <filters><field>Description</field><operator>NotEqualTo</operator><value><stringValue>blocked</stringValue></value></filters>
        <filters><field>NextStep</field><operator>IsNull</operator><value><booleanValue>false</booleanValue></value></filters>
        <filters><field>Amount</field><operator>GreaterThan</operator><value><numberValue>1000</numberValue></value></filters>
        <filters><field>Amount</field><operator>LessThanOrEqualTo</operator><value><numberValue>2000</numberValue></value></filters>
        <filters><field>CloseDate</field><operator>EqualTo</operator><value><dateValue>2027-01-15</dateValue></value></filters>
        <filters><field>StageName</field><operator>EqualTo</operator><value><stringValue>Prospecting</stringValue></value></filters>
        <filters><field>IsPrivate</field><operator>EqualTo</operator><value><booleanValue>false</booleanValue></value></filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>90</triggerOrder>
</Flow>
