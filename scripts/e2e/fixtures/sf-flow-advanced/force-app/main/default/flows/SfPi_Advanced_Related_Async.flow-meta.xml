<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Related_Update_Fault</name>
        <label>Capture Related Update Fault</label>
        <description>Captures a synchronous related-record update fault.</description>
        <locationX>350</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Async_Create_Fault</name>
        <label>Capture Async Create Fault</label>
        <description>Captures an asynchronous Task creation fault.</description>
        <locationX>550</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <description>After-save Account fixture proving a synchronous related-record update and an asynchronous-after-commit path.</description>
    <label>SF Pi Advanced Related and Async Paths</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Async_Evidence_Task</name>
        <label>Create Async Evidence Task</label>
        <description>Creates durable evidence from the asynchronous-after-commit path.</description>
        <locationX>500</locationX>
        <locationY>158</locationY>
        <faultConnector><targetReference>Capture_Async_Create_Fault</targetReference></faultConnector>
        <inputAssignments><field>OwnerId</field><value><elementReference>$Record.OwnerId</elementReference></value></inputAssignments>
        <inputAssignments><field>Priority</field><value><stringValue>Normal</stringValue></value></inputAssignments>
        <inputAssignments><field>Status</field><value><stringValue>Not Started</stringValue></value></inputAssignments>
        <inputAssignments><field>Subject</field><value><stringValue>SFPI async-after-commit evidence</stringValue></value></inputAssignments>
        <inputAssignments><field>WhatId</field><value><elementReference>$Record.Id</elementReference></value></inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Related_Contacts</name>
        <label>Update Related Contacts</label>
        <description>Updates all Contacts related to the triggering Account in the immediate path.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <faultConnector><targetReference>Capture_Related_Update_Fault</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>AccountId</field><operator>EqualTo</operator><value><elementReference>$Record.Id</elementReference></value></filters>
        <inputAssignments><field>Description</field><value><stringValue>SFPI synchronous related update</stringValue></value></inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Update_Related_Contacts</targetReference></connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters><field>AccountNumber</field><operator>EqualTo</operator><value><stringValue>SFPI-ADVANCED-PATHS</stringValue></value></filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Run_Asynchronously</name>
            <connector><targetReference>Create_Async_Evidence_Task</targetReference></connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>130</triggerOrder>
    <variables>
        <name>faultMessage</name><dataType>String</dataType><description>Fault text captured by either path.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput>
    </variables>
</Flow>
