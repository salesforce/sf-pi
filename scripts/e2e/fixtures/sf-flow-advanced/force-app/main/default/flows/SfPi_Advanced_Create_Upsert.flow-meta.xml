<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Upsert_Fault</name>
        <label>Capture Upsert Fault</label>
        <description>Returns a real Create Records upsert fault to the caller.</description>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Upsert_Complete</name>
        <label>Mark Upsert Complete</label>
        <description>Marks the Create Records upsert complete.</description>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>completed</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
    </assignments>
    <description>Autolaunched fixture that creates or updates one probe by its ExternalKey field.</description>
    <label>SF Pi Advanced Create Upsert</label>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Upsert_Probe</name>
        <label>Upsert Probe</label>
        <description>Creates or updates the exact probe matching the input external key.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector><targetReference>Mark_Upsert_Complete</targetReference></connector>
        <doesUpsert>true</doesUpsert>
        <doesUpsertAllOrNone>true</doesUpsertAllOrNone>
        <faultConnector><targetReference>Capture_Upsert_Fault</targetReference></faultConnector>
        <inputReference>inputRecord</inputReference>
        <upsertExternalIdField>ExternalKey__c</upsertExternalIdField>
    </recordCreates>
    <start><locationX>50</locationX><locationY>50</locationY><connector><targetReference>Upsert_Probe</targetReference></connector></start>
    <status>Draft</status>
    <variables><name>inputRecord</name><dataType>SObject</dataType><description>Probe to create or update by ExternalKey.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><objectType>SfPi_Flow_Probe__c</objectType></variables>
    <variables><name>completed</name><dataType>Boolean</dataType><description>True after upsert succeeds.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
    <variables><name>faultMessage</name><dataType>String</dataType><description>Upsert fault text.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
