<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Mark_Formula_Match</name>
        <label>Mark Formula Match</label>
        <description>Marks Opportunities whose entry formula evaluates true.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>$Record.Description</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>SFPI entry formula matched</stringValue></value>
        </assignmentItems>
    </assignments>
    <description>Before-save Opportunity fixture proving formula-based entry criteria.</description>
    <label>SF Pi Advanced Formula Conditions</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Mark_Formula_Match</targetReference></connector>
        <filterFormula>AND(BEGINS({!$Record.Name}, &quot;SFPI FORMULA&quot;), {!$Record.Amount} &gt;= 500)</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>120</triggerOrder>
</Flow>
