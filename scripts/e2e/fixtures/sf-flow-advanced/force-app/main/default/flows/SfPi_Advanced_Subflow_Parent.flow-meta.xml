<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Autolaunched parent fixture that executes a child Flow and maps primitive and record-collection inputs and outputs.</description>
    <label>SF Pi Advanced Subflow Parent</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Call_Contract_Subflow</targetReference></connector>
        <triggerType>None</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Call_Contract_Subflow</name>
        <label>Call Contract Subflow</label>
        <description>Passes both inputs to the reusable child and captures both outputs explicitly.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <flowName>SfPi_Advanced_Subflow_Child</flowName>
        <inputAssignments>
            <name>inputText</name>
            <value><elementReference>inputText</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <name>inputContacts</name>
            <value><elementReference>inputContacts</elementReference></value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>outputText</assignToReference>
            <name>outputText</name>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>outputContacts</assignToReference>
            <name>outputContacts</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>inputText</name>
        <dataType>String</dataType>
        <description>Primitive input forwarded to the child Flow.</description>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputContacts</name>
        <dataType>SObject</dataType>
        <description>Contact collection input forwarded to the child Flow.</description>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>outputText</name>
        <dataType>String</dataType>
        <description>Primitive output captured from the child Flow.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>outputContacts</name>
        <dataType>SObject</dataType>
        <description>Contact collection output captured from the child Flow.</description>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
