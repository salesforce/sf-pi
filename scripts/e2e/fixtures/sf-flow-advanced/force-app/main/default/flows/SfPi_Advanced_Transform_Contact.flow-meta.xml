<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Return_Transformed_Task</name>
        <label>Return Transformed Task</label>
        <description>Copies the Transform output into the public output variable.</description>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>outputTask</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Transform_Contact_To_Task</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Autolaunched fixture that maps one Contact resource to one Task resource with a real Transform element.</description>
    <label>SF Pi Advanced Transform Contact</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Transform_Contact_To_Task</targetReference></connector>
        <triggerType>None</triggerType>
    </start>
    <status>Draft</status>
    <transforms>
        <name>Transform_Contact_To_Task</name>
        <label>Transform Contact To Task</label>
        <description>Maps the input Contact LastName to the output Task Subject.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector><targetReference>Return_Transformed_Task</targetReference></connector>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <objectType>Task</objectType>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>Subject</outputFieldApiName>
                <transformType>Map</transformType>
                <value><elementReference>inputContact.LastName</elementReference></value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <name>inputContact</name>
        <dataType>SObject</dataType>
        <description>Contact resource to transform.</description>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>outputTask</name>
        <dataType>SObject</dataType>
        <description>Task resource produced by the Transform element.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Task</objectType>
    </variables>
</Flow>
