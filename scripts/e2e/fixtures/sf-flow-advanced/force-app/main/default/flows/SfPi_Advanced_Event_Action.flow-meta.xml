<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <actionCalls>
        <name>Build_Event_Details</name>
        <label>Build Event Details</label>
        <description>Runs the bulk-safe Apex action for each platform event message.</description>
        <locationX>176</locationX><locationY>158</locationY>
        <actionName>SfPiFlowBulkContractAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Create_Event_Task</targetReference></connector>
        <faultConnector><targetReference>Capture_Action_Fault</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters><name>recordKey</name><value><elementReference>$Record.Message__c</elementReference></value></inputParameters>
        <inputParameters><name>recordName</name><value><elementReference>$Record.Message__c</elementReference></value></inputParameters>
        <outputParameters><assignToReference>returnedKey</assignToReference><name>recordKey</name></outputParameters>
        <outputParameters><assignToReference>actionLabel</assignToReference><name>taskSubject</name></outputParameters>
        <outputParameters><assignToReference>batchSize</assignToReference><name>requestCount</name></outputParameters>
        <outputParameters><assignToReference>batchIndex</assignToReference><name>requestIndex</name></outputParameters>
    </actionCalls>
    <assignments>
        <name>Capture_Action_Fault</name>
        <label>Capture Action Fault</label>
        <description>Captures an Apex action failure.</description>
        <locationX>350</locationX><locationY>300</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Task_Fault</name>
        <label>Capture Task Fault</label>
        <description>Captures a Task creation failure.</description>
        <locationX>350</locationX><locationY>450</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <description>Platform-event fixture that proves 200-message Flow batching and invocable Apex output order.</description>
    <formulas>
        <name>Task_Description</name>
        <dataType>String</dataType>
        <expression>&quot;requestCount=&quot; &amp; TEXT({!batchSize}) &amp; &quot;;requestIndex=&quot; &amp; TEXT({!batchIndex}) &amp; &quot;;recordKey=&quot; &amp; {!returnedKey}</expression>
    </formulas>
    <label>SF Pi Advanced Event Action</label>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Event_Task</name>
        <label>Create Event Task</label>
        <description>Creates one Task containing the ordered Apex outputs for each event.</description>
        <locationX>176</locationX><locationY>300</locationY>
        <faultConnector><targetReference>Capture_Task_Fault</targetReference></faultConnector>
        <inputAssignments><field>Description</field><value><elementReference>Task_Description</elementReference></value></inputAssignments>
        <inputAssignments><field>OwnerId</field><value><elementReference>$User.Id</elementReference></value></inputAssignments>
        <inputAssignments><field>Priority</field><value><stringValue>Normal</stringValue></value></inputAssignments>
        <inputAssignments><field>Status</field><value><stringValue>Not Started</stringValue></value></inputAssignments>
        <inputAssignments><field>Subject</field><value><elementReference>actionLabel</elementReference></value></inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX><locationY>50</locationY>
        <connector><targetReference>Build_Event_Details</targetReference></connector>
        <object>SfPi_Advanced_Event__e</object>
        <triggerType>PlatformEvent</triggerType>
    </start>
    <status>Draft</status>
    <variables><name>returnedKey</name><dataType>String</dataType><description>Event key returned by Apex.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
    <variables><name>actionLabel</name><dataType>String</dataType><description>Task subject returned by Apex.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
    <variables><name>batchSize</name><dataType>Number</dataType><description>Apex request count.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale></variables>
    <variables><name>batchIndex</name><dataType>Number</dataType><description>Apex request index.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><scale>0</scale></variables>
    <variables><name>faultMessage</name><dataType>String</dataType><description>Fault text.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput></variables>
</Flow>
