<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Use_First_Email</name>
        <label>Use First Email</label>
        <description>Assigns the first filtered and sorted Contact Email to the triggering Account before save.</description>
        <locationX>176</locationX><locationY>590</locationY>
        <assignmentItems><assignToReference>$Record.Phone</assignToReference><operator>Assign</operator><value><elementReference>currentContact.Email</elementReference></value></assignmentItems>
        <connector><targetReference>For_Each_Contact</targetReference></connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Contacts_With_Email</name>
        <label>Filter Contacts With Email</label>
        <description>Returns a new collection containing only Contacts with Email.</description>
        <locationX>176</locationX><locationY>300</locationY>
        <assignNextValueToReference>filterContact</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Related_Contacts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions><leftValueReference>filterContact.Email</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions>
        <connector><targetReference>Sort_Filtered_Contacts</targetReference></connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Sort_Filtered_Contacts</name>
        <label>Sort Filtered Contacts</label>
        <description>Sorts by LastName and keeps only the first Contact.</description>
        <locationX>176</locationX><locationY>450</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Filter_Contacts_With_Email</collectionReference>
        <connector><targetReference>For_Each_Contact</targetReference></connector>
        <limit>1</limit>
        <sortOptions><doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst><sortField>LastName</sortField><sortOrder>Asc</sortOrder></sortOptions>
    </collectionProcessors>
    <description>Before-save Account fixture that filters and sorts related Contacts in 1- and 200-record update transactions.</description>
    <label>SF Pi Advanced Before Save Collection</label>
    <loops>
        <name>For_Each_Contact</name>
        <label>For Each Contact</label>
        <description>Consumes the single retained Contact without database operations.</description>
        <locationX>176</locationX><locationY>520</locationY>
        <assignNextValueToReference>currentContact</assignNextValueToReference>
        <collectionReference>Filter_Contacts_With_Email</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Use_First_Email</targetReference></nextValueConnector>
    </loops>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Related_Contacts</name>
        <label>Get Related Contacts</label>
        <description>Gets related Contacts before filtering and sorting.</description>
        <locationX>176</locationX><locationY>158</locationY>
        <connector><targetReference>Filter_Contacts_With_Email</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>AccountId</field><operator>EqualTo</operator><value><elementReference>$Record.Id</elementReference></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Email</queriedFields>
        <queriedFields>LastName</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX><locationY>50</locationY>
        <connector><targetReference>Get_Related_Contacts</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>AccountNumber</field><operator>EqualTo</operator><value><stringValue>SFPI-ADVANCED-BEFORE-COLLECTION</stringValue></value></filters>
        <object>Account</object><recordTriggerType>Update</recordTriggerType><triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>90</triggerOrder>
    <variables><name>filterContact</name><dataType>SObject</dataType><description>Current Contact evaluated by Collection Filter.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><objectType>Contact</objectType></variables>
    <variables><name>currentContact</name><dataType>SObject</dataType><description>Current retained Contact.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>false</isOutput><objectType>Contact</objectType></variables>
</Flow>
