<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Append_Second_Before_Token</name>
        <label>Append Second Before Token</label>
        <description>Appends the second explicit before-save token after the earlier Flow.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>$Record.NullableText__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Second_Before_Text</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Before-save probe fixture that appends the second explicit trigger-order token.</description>
    <formulas>
        <name>Second_Before_Text</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.NullableText__c}), &quot;B20&quot;, {!$Record.NullableText__c} &amp; &quot;;B20&quot;)</expression>
    </formulas>
    <label>SF Pi Advanced Order Before Second</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Append_Second_Before_Token</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Stage__c</field><operator>EqualTo</operator><value><stringValue>order-explicit</stringValue></value></filters>
        <object>SfPi_Flow_Probe__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>20</triggerOrder>
</Flow>
