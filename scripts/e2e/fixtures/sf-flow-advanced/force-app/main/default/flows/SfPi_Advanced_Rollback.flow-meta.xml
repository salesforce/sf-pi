<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Rollback_Fault</name>
        <label>Capture Rollback Fault</label>
        <description>Returns an unexpected database or rollback fault to the caller.</description>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Rolled_Back</name>
        <label>Mark Rolled Back</label>
        <description>Proves that execution continued after Roll Back Records.</description>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>rolledBack</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <connector><targetReference>Show_Rollback_Complete</targetReference></connector>
    </assignments>
    <description>Screen Flow fixture that creates a probe, rolls the transaction back, and displays completion evidence.</description>
    <label>SF Pi Advanced Rollback</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Probe_Before_Rollback</name>
        <label>Create Probe Before Rollback</label>
        <description>Creates the record that Roll Back Records must remove.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector><targetReference>Roll_Back_Records</targetReference></connector>
        <faultConnector><targetReference>Capture_Rollback_Fault</targetReference></faultConnector>
        <inputAssignments><field>Name</field><value><stringValue>Rollback Probe</stringValue></value></inputAssignments>
        <inputAssignments><field>CorrelationKey__c</field><value><elementReference>inputKey</elementReference></value></inputAssignments>
        <inputAssignments><field>Stage__c</field><value><stringValue>created-before-rollback</stringValue></value></inputAssignments>
        <object>SfPi_Flow_Probe__c</object>
    </recordCreates>
    <recordRollbacks>
        <name>Roll_Back_Records</name>
        <label>Roll Back Records</label>
        <description>Reverts the probe created earlier in this transaction.</description>
        <locationX>176</locationX>
        <locationY>250</locationY>
        <connector><targetReference>Mark_Rolled_Back</targetReference></connector>
    </recordRollbacks>
    <screens>
        <name>Show_Rollback_Complete</name>
        <label>Show Rollback Complete</label>
        <description>Displays browser-visible evidence after Roll Back Records completes.</description>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Rollback_Complete_Text</name>
            <fieldText>&lt;p&gt;SF Pi rollback complete for {!inputKey}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties><verticalAlignment><stringValue>top</stringValue></verticalAlignment><width><stringValue>12</stringValue></width></styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Create_Probe_Before_Rollback</targetReference></connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>inputKey</name><dataType>String</dataType><description>Run-scoped correlation key.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput>
    </variables>
    <variables>
        <name>rolledBack</name><dataType>Boolean</dataType><description>True after Roll Back Records executes.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput>
    </variables>
    <variables>
        <name>faultMessage</name><dataType>String</dataType><description>Unexpected Flow fault.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput>
    </variables>
</Flow>
