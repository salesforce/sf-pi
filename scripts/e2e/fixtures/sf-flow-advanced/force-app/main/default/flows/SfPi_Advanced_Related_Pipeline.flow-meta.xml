<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Create_Fault</name>
        <label>Capture Create Fault</label>
        <description>Captures a bulk related Task creation fault.</description>
        <locationX>350</locationX>
        <locationY>590</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>After-save Account fixture that gets related Contacts, invokes a collection-processing subflow, transforms the output to Tasks, and creates the collection once.</description>
    <label>SF Pi Advanced Related Pipeline</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Related_Tasks</name>
        <label>Create Related Tasks</label>
        <description>Creates the transformed Task collection in one bulk operation.</description>
        <locationX>176</locationX>
        <locationY>590</locationY>
        <faultConnector><targetReference>Capture_Create_Fault</targetReference></faultConnector>
        <inputReference>Transform_Contacts_To_Tasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Related_Contacts</name>
        <label>Get Related Contacts</label>
        <description>Gets every Contact related to the triggering Account before collection processing.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector><targetReference>Process_Related_Contacts</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Email</queriedFields>
        <queriedFields>LastName</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Get_Related_Contacts</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountNumber</field>
            <operator>EqualTo</operator>
            <value><stringValue>SFPI-ADVANCED-PIPELINE</stringValue></value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <subflows>
        <name>Process_Related_Contacts</name>
        <label>Process Related Contacts</label>
        <description>Runs the real collection Filter and Sort child Flow and captures its output.</description>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <connector><targetReference>Transform_Contacts_To_Tasks</targetReference></connector>
        <flowName>SfPi_Advanced_Filter_Sort_Contacts</flowName>
        <inputAssignments>
            <name>inputContacts</name>
            <value><elementReference>Get_Related_Contacts</elementReference></value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>processedContacts</assignToReference>
            <name>outputContacts</name>
        </outputAssignments>
    </subflows>
    <transforms>
        <name>Transform_Contacts_To_Tasks</name>
        <label>Transform Contacts To Tasks</label>
        <description>Maps the processed Contact collection to a Task collection related to the Account.</description>
        <locationX>176</locationX>
        <locationY>450</locationY>
        <connector><targetReference>Create_Related_Tasks</targetReference></connector>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <objectType>Task</objectType>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>Description</outputFieldApiName>
                <transformType>Map</transformType>
                <value><elementReference>processedContacts[$EachItem].Email</elementReference></value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>OwnerId</outputFieldApiName>
                <transformType>Map</transformType>
                <value><elementReference>$Record.OwnerId</elementReference></value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Priority</outputFieldApiName>
                <transformType>Map</transformType>
                <value><stringValue>Normal</stringValue></value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Status</outputFieldApiName>
                <transformType>Map</transformType>
                <value><stringValue>Not Started</stringValue></value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Subject</outputFieldApiName>
                <transformType>Map</transformType>
                <value><elementReference>processedContacts[$EachItem].LastName</elementReference></value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>WhatId</outputFieldApiName>
                <transformType>Map</transformType>
                <value><elementReference>$Record.Id</elementReference></value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <triggerOrder>60</triggerOrder>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <description>Fault text captured when bulk Task creation fails.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>processedContacts</name>
        <dataType>SObject</dataType>
        <description>Filtered and sorted Contacts returned by the child Flow.</description>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
</Flow>
