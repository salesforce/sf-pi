<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Schedule_Evidence_Fault</name>
        <label>Capture Schedule Evidence Fault</label>
        <description>Captures a failure while writing one scheduled evidence probe.</description>
        <locationX>350</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Schedule-triggered probe fixture that writes one evidence record per matching source without a custom batch size.</description>
    <formulas>
        <name>Evidence_Key</name>
        <dataType>String</dataType>
        <expression>&quot;e-&quot; &amp; {!$Record.ExternalKey__c}</expression>
    </formulas>
    <label>SF Pi Advanced Scheduled Bulk</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Schedule_Evidence</name>
        <label>Create Schedule Evidence</label>
        <description>Creates one evidence probe for the scheduled source record.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <faultConnector><targetReference>Capture_Schedule_Evidence_Fault</targetReference></faultConnector>
        <inputAssignments><field>Name</field><value><stringValue>Schedule Bulk Evidence</stringValue></value></inputAssignments>
        <inputAssignments><field>CorrelationKey__c</field><value><elementReference>$Record.CorrelationKey__c</elementReference></value></inputAssignments>
        <inputAssignments><field>ExternalKey__c</field><value><elementReference>Evidence_Key</elementReference></value></inputAssignments>
        <inputAssignments><field>NullableText__c</field><value><elementReference>$Record.ExternalKey__c</elementReference></value></inputAssignments>
        <inputAssignments><field>Parent__c</field><value><elementReference>$Record.Id</elementReference></value></inputAssignments>
        <inputAssignments><field>Stage__c</field><value><stringValue>schedule-bulk-evidence</stringValue></value></inputAssignments>
        <object>SfPi_Flow_Probe__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Create_Schedule_Evidence</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Stage__c</field><operator>EqualTo</operator><value><stringValue>schedule-bulk-source</stringValue></value></filters>
        <object>SfPi_Flow_Probe__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2027-01-01</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <description>Scheduled evidence create fault text.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
