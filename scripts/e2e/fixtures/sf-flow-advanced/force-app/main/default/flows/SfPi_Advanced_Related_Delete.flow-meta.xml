<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Delete_Fault</name>
        <label>Capture Delete Fault</label>
        <description>Returns a related-record deletion fault to the caller.</description>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Deleted</name>
        <label>Mark Deleted</label>
        <description>Marks the bounded related-record delete complete.</description>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignmentItems><assignToReference>completed</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
    </assignments>
    <description>Autolaunched fixture that deletes only child probes matching both parent and correlation key.</description>
    <label>SF Pi Advanced Related Delete</label>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Matching_Children</name>
        <label>Delete Matching Children</label>
        <description>Deletes only run-scoped children and preserves unrelated records.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <connector><targetReference>Mark_Deleted</targetReference></connector>
        <faultConnector><targetReference>Capture_Delete_Fault</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters><field>Parent__c</field><operator>EqualTo</operator><value><elementReference>parentId</elementReference></value></filters>
        <filters><field>CorrelationKey__c</field><operator>EqualTo</operator><value><elementReference>inputKey</elementReference></value></filters>
        <object>SfPi_Flow_Probe__c</object>
    </recordDeletes>
    <start><locationX>50</locationX><locationY>50</locationY><connector><targetReference>Delete_Matching_Children</targetReference></connector></start>
    <status>Draft</status>
    <variables><name>parentId</name><dataType>String</dataType><description>Parent probe ID.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>inputKey</name><dataType>String</dataType><description>Run-scoped correlation key.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>completed</name><dataType>Boolean</dataType><description>True after deletion succeeds.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
    <variables><name>faultMessage</name><dataType>String</dataType><description>Delete fault text.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
