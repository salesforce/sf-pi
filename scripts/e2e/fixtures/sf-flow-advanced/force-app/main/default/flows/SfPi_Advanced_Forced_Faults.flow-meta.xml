<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <actionCalls>
        <name>Force_Action_Fault</name>
        <label>Force Action Fault</label>
        <description>Calls the deterministic Apex action with its failure flag enabled.</description>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <actionName>SfPiFlowFaultAction</actionName>
        <actionType>apex</actionType>
        <connector><targetReference>Mark_Unexpected_Success</targetReference></connector>
        <faultConnector><targetReference>Capture_Action_Fault</targetReference></faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters><name>marker</name><value><elementReference>inputKey</elementReference></value></inputParameters>
        <inputParameters><name>shouldFail</name><value><booleanValue>true</booleanValue></value></inputParameters>
    </actionCalls>
    <assignments>
        <name>Capture_Action_Fault</name>
        <label>Capture Action Fault</label>
        <description>Proves that the Apex action actually entered its fault connector.</description>
        <locationX>50</locationX>
        <locationY>450</locationY>
        <assignmentItems><assignToReference>faultKind</assignToReference><operator>Assign</operator><value><stringValue>action</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Capture_Database_Fault</name>
        <label>Capture Database Fault</label>
        <description>Proves that validation prevented the record create and entered its fault connector.</description>
        <locationX>300</locationX>
        <locationY>450</locationY>
        <assignmentItems><assignToReference>faultKind</assignToReference><operator>Assign</operator><value><stringValue>database</stringValue></value></assignmentItems>
        <assignmentItems><assignToReference>faultMessage</assignToReference><operator>Assign</operator><value><elementReference>$Flow.FaultMessage</elementReference></value></assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Unexpected_Success</name>
        <label>Mark Unexpected Success</label>
        <description>Fails the runtime contract if either deliberately faulty operation succeeds.</description>
        <locationX>550</locationX>
        <locationY>450</locationY>
        <assignmentItems><assignToReference>unexpectedSuccess</assignToReference><operator>Assign</operator><value><booleanValue>true</booleanValue></value></assignmentItems>
    </assignments>
    <decisions>
        <name>Select_Fault</name>
        <label>Select Fault</label>
        <description>Selects one exact fault mechanism from the caller input.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector><targetReference>Mark_Unexpected_Success</targetReference></defaultConnector>
        <defaultConnectorLabel>Unsupported</defaultConnectorLabel>
        <rules>
            <name>Action_Fault</name>
            <conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>faultMode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>action</stringValue></rightValue></conditions>
            <connector><targetReference>Force_Action_Fault</targetReference></connector>
            <label>Action Fault</label>
        </rules>
        <rules>
            <name>Database_Fault</name>
            <conditionLogic>and</conditionLogic>
            <conditions><leftValueReference>faultMode</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>database</stringValue></rightValue></conditions>
            <connector><targetReference>Force_Database_Fault</targetReference></connector>
            <label>Database Fault</label>
        </rules>
    </decisions>
    <description>Autolaunched fixture that forces and observes real action and database faults.</description>
    <label>SF Pi Advanced Forced Faults</label>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Force_Database_Fault</name>
        <label>Force Database Fault</label>
        <description>Creates a probe that the fixture validation rule must reject.</description>
        <locationX>300</locationX>
        <locationY>300</locationY>
        <connector><targetReference>Mark_Unexpected_Success</targetReference></connector>
        <faultConnector><targetReference>Capture_Database_Fault</targetReference></faultConnector>
        <inputAssignments><field>Name</field><value><stringValue>Rejected Probe</stringValue></value></inputAssignments>
        <inputAssignments><field>CorrelationKey__c</field><value><elementReference>inputKey</elementReference></value></inputAssignments>
        <inputAssignments><field>Reject__c</field><value><booleanValue>true</booleanValue></value></inputAssignments>
        <object>SfPi_Flow_Probe__c</object>
    </recordCreates>
    <start><locationX>50</locationX><locationY>50</locationY><connector><targetReference>Select_Fault</targetReference></connector></start>
    <status>Draft</status>
    <variables><name>faultMode</name><dataType>String</dataType><description>Either action or database.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>inputKey</name><dataType>String</dataType><description>Run-scoped correlation key.</description><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput></variables>
    <variables><name>faultKind</name><dataType>String</dataType><description>Observed fault path.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
    <variables><name>faultMessage</name><dataType>String</dataType><description>Observed Flow fault text.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
    <variables><name>unexpectedSuccess</name><dataType>Boolean</dataType><description>True only if the requested fault did not occur.</description><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput></variables>
</Flow>
