<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Capture_Deleted_Account_Name</name>
        <label>Capture Deleted Account Name</label>
        <description>Copies the deleting Account Name into an in-memory status value.</description>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>statusMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Name</elementReference></value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Account_Has_Name</name>
        <label>Account Has Name</label>
        <description>Branches on the deleting Account Name.</description>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Name Missing</defaultConnectorLabel>
        <rules>
            <name>Name_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Capture_Deleted_Account_Name</targetReference></connector>
            <label>Name Present</label>
        </rules>
    </decisions>
    <description>Draft before-delete Account fixture with one decision and in-memory outcome assignment.</description>
    <label>SF Pi Hardening Before Delete</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Account_Has_Name</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Account</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Draft</status>
    <triggerOrder>40</triggerOrder>
    <variables>
        <name>statusMessage</name>
        <dataType>String</dataType>
        <description>In-memory delete context summary.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
