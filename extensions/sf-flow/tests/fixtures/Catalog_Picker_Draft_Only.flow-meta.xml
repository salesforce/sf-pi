<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Add_To_Totals</name>
        <label>Add To Totals</label>
        <locationX>578</locationX>
        <locationY>1250</locationY>
        <description>Adds one product and its line total to the running summary values.</description>
        <assignmentItems>
            <assignToReference>productsAdded</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>totalValue</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>CurrentLineTotal</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Line_Items</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Pricebook</name>
        <label>Has Pricebook?</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <description>Stops with a message when the Opportunity has no Pricebook, since no entries can be listed.</description>
        <defaultConnector>
            <targetReference>No_Pricebook_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Pricebook</defaultConnectorLabel>
        <rules>
            <name>Pricebook_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity.Pricebook2Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Active_Pricebook_Entries</targetReference>
            </connector>
            <label>Pricebook Present</label>
        </rules>
    </decisions>
    <description>Screen flow for the Opportunity record page. The rep picks a Product Family, selects products from a data table sorted by list price, and the flow creates OpportunityLineItems (Quantity 1) and shows a summary. </description>
    <dynamicChoiceSets>
        <name>Family_Choices</name>
        <dataType>Picklist</dataType>
        <picklistField>Family</picklistField>
        <picklistObject>Product2</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>CurrentLineTotal</name>
        <dataType>Number</dataType>
        <expression>{!Loop_Line_Items.UnitPrice} * {!Loop_Line_Items.Quantity}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Catalog Line Item Picker {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Catalog Line Item Picker</label>
    <loops>
        <name>Loop_Line_Items</name>
        <label>Loop Line Items</label>
        <locationX>314</locationX>
        <locationY>1142</locationY>
        <description>Counts the created line items and totals their value for the summary.</description>
        <collectionReference>Transform_To_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_To_Totals</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Summary_Screen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Line_Items</name>
        <label>Create Line Items</label>
        <locationX>314</locationX>
        <locationY>1034</locationY>
        <description>Creates the OpportunityLineItems built from the selected entries.</description>
        <connector>
            <targetReference>Loop_Line_Items</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <inputReference>Transform_To_Line_Items</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Opportunity</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <description>Reads the Opportunity Pricebook for the record the flow runs on.</description>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Pricebook</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Pricebook2Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Active_Pricebook_Entries</name>
        <label>Get Active Pricebook Entries</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <description>Reads the active PricebookEntries of the Opportunity Pricebook, with Product Family.</description>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Pick_Family_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pricebook2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Opportunity.Pricebook2Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>PricebookEntry</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Product2Id</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <queriedFields>Product2.Family</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Pick_Family_Screen</name>
        <label>Pick Product Family</label>
        <description>Screen 1: the rep chooses the Product Family to browse.</description>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Filter_By_Family</targetReference>
        </connector>
        <fields>
            <name>Family_Picker</name>
            <choiceReferences>Family_Choices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Product Family</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Select_Products_Screen</name>
        <label>Select Products</label>
        <description>Screen 2: data table of the filtered, price-sorted entries where the rep selects products to add.</description>
        <locationX>314</locationX>
        <locationY>818</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Transform_To_Line_Items</targetReference>
        </connector>
        <fields>
            <name>Product_Table</name>
            <dataTypeMappings>
                <typeName>T</typeName>
                <typeValue>PricebookEntry</typeValue>
            </dataTypeMappings>
            <extensionName>flowruntime:datatable</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>label</name>
                <value>
                    <stringValue>Select the products to add</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>tableData</name>
                <value>
                    <elementReference>Sort_By_Unit_Price</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>columns</name>
                <value>
                    <stringValue>[{&quot;apiName&quot;:&quot;Name&quot;,&quot;guid&quot;:&quot;column-a1b2&quot;,&quot;editable&quot;:false,&quot;hasCustomHeaderLabel&quot;:true,&quot;customHeaderLabel&quot;:&quot;Product&quot;,&quot;wrapText&quot;:true,&quot;order&quot;:0,&quot;label&quot;:&quot;Product&quot;,&quot;type&quot;:&quot;text&quot;},{&quot;apiName&quot;:&quot;UnitPrice&quot;,&quot;guid&quot;:&quot;column-c3d4&quot;,&quot;editable&quot;:false,&quot;hasCustomHeaderLabel&quot;:true,&quot;customHeaderLabel&quot;:&quot;List Price&quot;,&quot;wrapText&quot;:true,&quot;order&quot;:1,&quot;label&quot;:&quot;List Price&quot;,&quot;type&quot;:&quot;currency&quot;}]</stringValue>
