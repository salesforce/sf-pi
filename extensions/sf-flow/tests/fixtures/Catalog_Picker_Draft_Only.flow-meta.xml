            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Summary_Screen</name>
        <label>Summary</label>
        <description>Shows the number of products added and their total value.</description>
        <locationX>314</locationX>
        <locationY>1442</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Summary_Text</name>
            <fieldText>&lt;p&gt;Products added: {!productsAdded}&lt;/p&gt;&lt;p&gt;Total value: {!totalValue}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Pricebook_Screen</name>
        <label>No Pricebook</label>
        <description>Tells the rep the Opportunity has no Pricebook, so no products can be listed.</description>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>No_Pricebook_Text</name>
            <fieldText>&lt;p&gt;This Opportunity has no Pricebook. Set a Pricebook before adding products.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Error</label>
        <description>Shows the fault message when a lookup or the line item create fails.</description>
        <locationX>842</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>&lt;p&gt;Something went wrong: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <collectionProcessors>
        <name>Filter_By_Family</name>
        <label>Filter By Family</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <description>Keeps only the entries whose Product Family equals the rep's choice.</description>
        <assignNextValueToReference>currentEntry</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Active_Pricebook_Entries</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentEntry.Product2.Family</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Family_Picker.value</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Sort_By_Unit_Price</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Sort_By_Unit_Price</name>
        <label>Sort By Unit Price</label>
        <locationX>314</locationX>
        <locationY>746</locationY>
        <description>Sorts the filtered entries by UnitPrice, lowest first.</description>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>Filter_By_Family</collectionReference>
        <connector>
            <targetReference>Select_Products_Screen</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>UnitPrice</sortField>
            <sortOrder>Asc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Opportunity</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <transforms>
        <name>Transform_To_Line_Items</name>
        <label>Transform To Line Items</label>
        <locationX>314</locationX>
        <locationY>926</locationY>
        <description>Maps each selected entry to an OpportunityLineItem with Quantity 1.</description>
        <connector>
            <targetReference>Create_Line_Items</targetReference>
        </connector>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <objectType>OpportunityLineItem</objectType>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <transformValues>
            <transformValueActions>
                <outputFieldApiName>OpportunityId</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>recordId</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>PricebookEntryId</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Product_Table.selectedRows[$EachItem].Id</elementReference>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>Quantity</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <numberValue>1.0</numberValue>
                </value>
            </transformValueActions>
            <transformValueActions>
                <outputFieldApiName>UnitPrice</outputFieldApiName>
                <transformType>Map</transformType>
                <value>
                    <elementReference>Product_Table.selectedRows[$EachItem].UnitPrice</elementReference>
                </value>
            </transformValueActions>
        </transformValues>
    </transforms>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <description>Id of the Opportunity the flow runs on (record page).</description>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>currentEntry</name>
        <dataType>SObject</dataType>
        <description>Loop item used by the Family filter.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PricebookEntry</objectType>
    </variables>
    <variables>
        <name>productsAdded</name>
        <dataType>Number</dataType>
        <description>Number of line items created.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>totalValue</name>
        <dataType>Number</dataType>
        <description>Sum of UnitPrice x Quantity for the created line items.</description>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
