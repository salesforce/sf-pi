{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // Pi loads extensions with its pi-ai extension view (TypeBox StringEnum,
    // Type, Static); type-check against that view, with the published
    // entrypoint as the fallback for Pi releases that do not ship it.
    "paths": {
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-coding-agent/dist/core/extensions/pi-ai-extension-view.d.ts",
        "./node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ]
    }
  },
  "include": ["extensions/**/*.ts", "catalog/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
