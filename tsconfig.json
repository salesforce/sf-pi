{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sf-pi/apex": ["./extensions/sf-apex/public.ts"]
    }
  },
  "include": ["extensions/**/*.ts", "catalog/**/*.ts", "lib/cli/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
