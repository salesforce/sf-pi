{
  "name": "sf-pi",
  "version": "0.268.0",
  "private": true,
  "type": "module",
  "description": "Opinionated Salesforce developer extensions for the pi coding agent — Apex/LWC LSP, Agent Script authoring, Slack research, and a TUI manager.",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "salesforce",
    "salesforce-dev",
    "developer-tools"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Salesforce, Inc.",
    "url": "https://github.com/salesforce"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salesforce/sf-pi.git"
  },
  "bugs": {
    "url": "https://github.com/salesforce/sf-pi/issues"
  },
  "homepage": "https://github.com/salesforce/sf-pi#readme",
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./extensions/sf-welcome/index.ts",
      "./extensions/sf-devbar/index.ts",
      "./extensions/sf-ohana-spinner/index.ts",
      "./extensions/sf-pi-manager/index.ts",
      "./extensions/sf-llm-gateway/index.ts",
      "./extensions/sf-guardrail/index.ts",
      "./extensions/sf-brain/index.ts",
      "./extensions/sf-apex/index.ts",
      "./extensions/sf-soql/index.ts",
      "./extensions/sf-lwc/index.ts",
      "./extensions/sf-browser/index.ts",
      "./extensions/sf-code-analyzer/index.ts",
      "./extensions/sf-slack/index.ts",
      "./extensions/sf-data360/index.ts",
      "./extensions/sf-data-explorer/index.ts",
      "./extensions/sf-docs/index.ts",
      "./extensions/sf-tldraw/index.ts",
      "./extensions/sf-herdr/index.ts",
      "./extensions/sf-lsp/index.ts",
      "./extensions/sf-agentscript/index.ts",
      "./extensions/sf-skills/index.ts",
      "./extensions/sf-feedback/index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "generate-catalog": "node scripts/generate-catalog.mjs",
    "generate-catalog:check": "node scripts/generate-catalog.mjs --check",
    "generate-catalog:check-staged": "node scripts/check-staged-catalog.mjs",
    "import-d360-upstream": "node scripts/import-d360-upstream.mjs",
    "import-d360-upstream:check": "node scripts/import-d360-upstream.mjs --check",
    "generate-d360-registry": "node scripts/generate-d360-registry.mjs",
    "generate-d360-registry:check": "node scripts/generate-d360-registry.mjs --check",
    "generate-d360-references": "node scripts/generate-d360-references.mjs",
    "generate-d360-references:check": "node scripts/generate-d360-references.mjs --check",
    "generate-d360-payload-examples": "node scripts/generate-d360-payload-examples.mjs",
    "generate-d360-payload-examples:check": "node scripts/generate-d360-payload-examples.mjs --check",
    "generate-d360-v2-actions": "node scripts/generate-d360-v2-actions.mjs",
    "generate-d360-v2-actions:check": "node scripts/generate-d360-v2-actions.mjs --check",
    "docs:health": "node scripts/docs-health.mjs",
    "docs:health:check": "node scripts/docs-health.mjs --check",
    "docs:links:report": "node scripts/check-external-links.mjs",
    "check:architecture": "node scripts/check-architecture.mjs --check",
    "spdx": "node scripts/add-spdx-headers.mjs",
    "spdx:check": "node scripts/add-spdx-headers.mjs --check",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:commands": "node scripts/check-command-contracts.mjs",
    "check:manager-first": "vitest run scripts/tests/manager-first-commands.test.ts",
    "check:boot-path": "node scripts/check-boot-path.mjs",
    "check:salesforce-connection": "node scripts/check-salesforce-connection-module.mjs",
    "check:lifecycle-scripts": "node scripts/check-lifecycle-scripts.mjs",
    "eslint": "eslint . --max-warnings=0",
    "eslint:fix": "eslint . --fix",
    "lint": "npm run format:check && npm run generate-d360-registry:check && npm run generate-d360-references:check && npm run generate-d360-payload-examples:check && npm run generate-d360-v2-actions:check && npm run generate-d360-parity:check && npm run generate-catalog:check && npm run docs:health:check && npm run check:architecture && npm run spdx:check && npm run check:salesforce-connection && npm run check:lifecycle-scripts && npm run eslint",
    "validate:ci": "npm run validate && npm run eslint && npm run docs:health:check && bash scripts/check-llm-artifacts.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:runtime-surface": "vitest run scripts/tests/runtime-surface-attestation.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "agentscript:versions": "node --experimental-strip-types scripts/agentscript-versions.mjs",
    "e2e:data360-v2": "node --experimental-strip-types scripts/e2e/data360-v2-action-sweep.ts",
    "e2e:d360-stdm": "node --experimental-strip-types scripts/e2e/d360-stdm-e2e.ts",
    "e2e:d360-tracing": "node --experimental-strip-types scripts/e2e/d360-agent-platform-tracing-e2e.ts",
    "e2e:sf-herdr": "node --experimental-strip-types scripts/e2e/sf-herdr-live-smoke.ts",
    "e2e:sf-apex-harness": "node --experimental-strip-types scripts/e2e/sf-apex-harness-e2e.ts",
    "e2e:sf-browser-harden": "node --experimental-strip-types scripts/e2e/sf-browser-pack-harden.ts",
    "validate": "./scripts/validate.sh",
    "scaffold": "node scripts/scaffold.mjs",
    "preinstall": "node scripts/check-node-version.mjs",
    "prepare": "node scripts/prepare.mjs",
    "generate-d360-parity": "node scripts/generate-d360-parity.mjs",
    "generate-d360-parity:check": "node scripts/generate-d360-parity.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "e2e:sf-soql": "node --experimental-strip-types scripts/e2e/sf-soql-e2e.ts",
    "e2e:sf-lwc": "node --experimental-strip-types scripts/e2e/sf-lwc-e2e.ts",
    "instruction-surface:report": "node scripts/instruction-surface-report.mjs",
    "e2e:instruction-behavior": "node --experimental-strip-types scripts/e2e/instruction-behavior/run.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.82.0 <1.0.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@eslint/js": "^10.0.1",
    "@sf-agentscript/agentfabric-dialect": "1.2.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "string-argv": "^0.3.2",
    "typebox": "^1.3.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.6",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@lwc/compiler": "^9.4.1",
    "@lwc/template-compiler": "^9.3.4",
    "@salesforce-ux/design-system": "2.264.0",
    "@salesforce/apex-node": "^9.0.3",
    "@salesforce/core": "^9.1.2",
    "@salesforce/kit": "^4.0.0",
    "@salesforce/soql-common": "^2.0.0",
    "@salesforce/soql-language-server": "^1.1.0",
    "@salesforce/source-deploy-retrieve": "^13.1.1",
    "@sf-agentscript/agentforce": "2.9.27",
    "@sf-agentscript/language": "2.20.0",
    "@sf-agentscript/lsp": "2.5.24",
    "node-emoji": "^2.2.0",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "overridesNotes": {
    "fast-xml-parser": "Force >= 5.7.0 to clear GHSA-gh4j-gqv2-49f6 (XMLBuilder CDATA injection). Reaches sf-pi through pi-ai -> AWS SDK Bedrock client; remove once upstream AWS SDK resolves the advisory.",
    "vitepress": "VitePress 1.6.4 currently depends on Vite 5.x. Keep VitePress on the stable 1.x line for docs, but override its nested Vite/plugin-vue stack to patched versions that clear active Vite/esbuild advisories and still pass the docs build. Remove once VitePress 1.x or a stable 2.x release carries patched transitive dependencies.",
    "form-data": "Force >= 4.0.6 to clear GHSA-hmw2-7cc7-3qxx (CRLF injection in multipart field names/filenames). Reaches sf-pi through @salesforce/core -> @jsforce/jsforce-node; remove once upstream ranges naturally resolve to a patched version.",
    "vitest": "Vitest resolves Vite as a transitive test runner dependency. Force the patched Vite 7 line for tests until Vitest naturally resolves to a patched Vite release without overrides.",
    "esbuild": "Force >= 0.28.1 to clear GHSA-gv7w-rqvm-qjhr. Vite uses esbuild as build/test tooling; remove once all Vite ranges in the tree naturally require a patched esbuild.",
    "vite": "Direct dev dependency used to satisfy Vite peer imports for VitePress/Vitest while pinning a patched Vite line. Keep aligned with the transitive Vite overrides and remove only if docs/test tooling no longer requires a root peer install.",
    "minimatch": "Force minimatch 10.2.5+ across the dependency tree and lock production brace-expansion to 5.0.9+ to clear GHSA-mh99-v99m-4gvg and GHSA-rgw5-rvv9-x895. Remove once @salesforce/source-deploy-retrieve and vscode-languageclient naturally require patched matcher releases. Pi's audited development package currently shrinkwraps its own nested matcher tree."
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "form-data": "^4.0.6",
    "vitepress": {
      "vite": "7.3.5",
      "@vitejs/plugin-vue": "^6.0.7"
    },
    "vitest": {
      "vite": "7.3.5"
    },
    "@vitest/mocker": {
      "vite": "7.3.5"
    },
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.5"
  }
}
